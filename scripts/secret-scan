#!/usr/bin/env python3
"""Pre-commit secret scanner for staged diffs and file trees."""

import argparse
import math
import os
import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import unquote, unquote_plus


ALLOW_PRAGMA = "secret-scan: allow"
INLINE_CODE_RE = re.compile(r"`[^`]+`")
ASSIGNMENT_RE = re.compile(r"(?<![A-Za-z0-9_])['\"]?([A-Za-z_][A-Za-z0-9_]*)['\"]?\s*[:=]\s*")
SUPERMEMORY_BARE_RE = re.compile(r"\b(sm_[A-Za-z0-9]{20,})\b")
TAILSCALE_AUTHKEY_RE = re.compile(r"\b(tskey-[A-Za-z0-9-]+)\b")
OP_URI_RE = re.compile(r"\b(op://[A-Za-z0-9_. -]+/[A-Za-z0-9_. -]+(?:/[A-Za-z0-9_. -]+)*)(?=\s*(?:#|$))")
BEARER_TOKEN_RE = re.compile(r"\bAuthorization:\s*Bearer\s+([A-Za-z0-9._~+/=-]{16,})\b", re.IGNORECASE)
HIGH_ENTROPY_TOKEN_RE = re.compile(r"(?<![A-Za-z0-9+/])([A-Za-z0-9+/]{32,}={0,2})(?![A-Za-z0-9+/=])")
HIGH_RISK_TOKEN_RE = re.compile(
    r"\b("
    r"(?:ghp_|gho_)[A-Za-z0-9]{20,}"
    r"|github_pat_[A-Za-z0-9_]{20,}"
    r"|sk-[A-Za-z0-9]{20,}"
    r"|xox[bp]-[A-Za-z0-9-]{20,}"
    r"|AKIA[0-9A-Z]{16}"
    r"|eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}"
    r")\b"
)
HEX_RE = re.compile(r"^[0-9a-f]{32,}$")
HUNK_RE = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@")
URL_RE = re.compile(r"https?://[^\s<>'\"]+")
CREDENTIAL_IDENTIFIER_SEGMENTS = {
    "KEY",
    "TOKEN",
    "SECRET",
    "PASSWORD",
    "PASSWD",
    "CREDENTIAL",
    "CREDENTIALS",
    "AUTH",
    "AUTHORIZATION",
    "APIKEY",
}
CREDENTIAL_QUERY_PARAMS = {"key", "token", "secret", "auth", "signature", "sig", "apikey", "api_key"}
PLACEHOLDER_WORDS = {
    "",
    "change_me",
    "changeme",
    "example",
    "placeholder",
    "replace_me",
    "replaceme",
    "token",
    "todo",
    "xxx",
}
SHA256_MARKERS = ("sha256", "sources_sha256", "body_sha256", "query_sha256")
COMMIT_CONTEXT_RE = re.compile(r"\b(commit|commits|revision|rev|git show|git log)\b", re.IGNORECASE)
SHA_CONTEXT_RE = re.compile(r"\b[A-Za-z0-9_]*sha[A-Za-z0-9_]*\b\s*[:=]", re.IGNORECASE)


class SecretScanError(Exception):
    """Raised for usage and scanner errors."""


def parse_value(line, start):
    rest = line[start:].strip()
    if not rest or rest.startswith("#"):
        return ""
    if rest[0] in ("'", '"'):
        quote = rest[0]
        end = rest.find(quote, 1)
        if end != -1:
            return rest[1:end].strip()
        return rest[1:].strip()
    value = rest.split("#", 1)[0].strip()
    if not value:
        return ""
    return value.split()[0].rstrip(",;").strip()


def is_placeholder(value, identifier=None):
    stripped = value.strip().strip("'\"")
    lowered = stripped.lower()
    lowered_normalized = re.sub(r"[^a-z0-9]+", "_", lowered).strip("_")
    if lowered_normalized in PLACEHOLDER_WORDS:
        return True
    if stripped.startswith("<") and stripped.endswith(">"):
        return True
    if "replace" in lowered_normalized or "placeholder" in lowered_normalized:
        return True
    if stripped and len(set(stripped)) == 1:
        return True
    if identifier and stripped.lower() == identifier.lower():
        return True
    return False


def looks_real_value(value, identifier=None, min_length=16):
    return len(value.strip().strip("'\"")) >= min_length and not is_placeholder(value, identifier)


def looks_like_code_expression(value):
    stripped = value.strip()
    return (
        "(" in stripped
        or stripped.startswith(("args.", "self.", "re.", "Path(", "os.", "sys."))
        or stripped in ("True", "False", "None")
    )


def identifier_segments(identifier):
    with_acronym_boundaries = re.sub(r"([A-Z]+)([A-Z][a-z])", r"\1 \2", identifier)
    with_camel_boundaries = re.sub(r"([a-z0-9])([A-Z])", r"\1 \2", with_acronym_boundaries)
    return [
        segment.upper()
        for segment in re.split(r"[^A-Za-z0-9]+", with_camel_boundaries)
        if segment
    ]


def is_credential_identifier(identifier):
    return any(segment in CREDENTIAL_IDENTIFIER_SEGMENTS for segment in identifier_segments(identifier))


def is_supermemory_credential_identifier(identifier):
    upper = identifier.upper()
    return "SUPERMEMORY" in upper and is_credential_identifier(identifier)


def has_credential_assignment_context(line, token):
    for match in ASSIGNMENT_RE.finditer(line):
        identifier = match.group(1)
        if not is_credential_identifier(identifier):
            continue
        value = parse_value(line, match.end())
        if token in value:
            return True
    return False


def has_credential_query_context(line, token):
    for url_match in URL_RE.finditer(line):
        url = url_match.group(0).rstrip("),.;]")
        query_start = url.find("?")
        if query_start == -1:
            continue
        query = url[query_start + 1 :]
        fragment_start = query.find("#")
        if fragment_start != -1:
            query = query[:fragment_start]
        for part in re.split(r"[&;]", query):
            if "=" not in part:
                continue
            name, raw_value = part.split("=", 1)
            if unquote_plus(name).lower() not in CREDENTIAL_QUERY_PARAMS:
                continue
            decoded_values = {raw_value, unquote(raw_value), unquote_plus(raw_value)}
            if any(token in value for value in decoded_values):
                return True
    return False


def is_known_high_risk_token(token):
    return bool(HIGH_RISK_TOKEN_RE.fullmatch(token)) and (not token.startswith("eyJ") or len(token) >= 40)


def has_high_entropy_context(line, token):
    return (
        has_credential_assignment_context(line, token)
        or has_credential_query_context(line, token)
        or is_known_high_risk_token(token)
    )


def shannon_entropy(text):
    counts = {}
    for char in text:
        counts[char] = counts.get(char, 0) + 1
    entropy = 0.0
    length = len(text)
    for count in counts.values():
        probability = count / length
        entropy -= probability * math.log2(probability)
    return entropy


def has_sha256_context(lines, index):
    start = max(0, index - 1)
    end = min(len(lines), index + 2)
    for nearby in lines[start:end]:
        lowered = nearby.lower()
        if any(marker in lowered for marker in SHA256_MARKERS):
            return True
        if SHA_CONTEXT_RE.search(nearby):
            return True
    return False


def has_commit_context(line):
    lowered = line.lower()
    if "github.com" in lowered and "/commit/" in lowered:
        return True
    return bool(COMMIT_CONTEXT_RE.search(line))


def redact(line, secrets):
    redacted = line.rstrip("\n")
    for secret in sorted({secret for secret in secrets if secret}, key=len, reverse=True):
        redacted = redacted.replace(secret, secret[:4] + "...")
    if len(redacted) > 180:
        redacted = redacted[:177].rstrip() + "..."
    return redacted.strip()


def finding(path, line_number, rule_id, line, secrets):
    return f"{path}:{line_number}: {rule_id}: {redact(line, secrets)}"


def line_hits(line, lines, index):
    if ALLOW_PRAGMA in line:
        return []

    hits = []
    specific_secret_values = []

    for match in ASSIGNMENT_RE.finditer(line):
        identifier = match.group(1)
        identifier_upper = identifier.upper()
        value = parse_value(line, match.end())
        if (
            "MEILI" in identifier_upper
            and re.search(r"MEILI.*(?:_API)?_?KEY", identifier_upper)
            and not looks_like_code_expression(value)
            and looks_real_value(value, identifier)
        ):
            specific_secret_values.append(value)
            hits.append(("meili-key", [value]))

        if is_supermemory_credential_identifier(identifier) and not looks_like_code_expression(value) and looks_real_value(value, identifier):
            specific_secret_values.append(value)
            hits.append(("supermemory-token", [value]))

    for match in SUPERMEMORY_BARE_RE.finditer(line):
        value = match.group(1)
        specific_secret_values.append(value)
        hits.append(("supermemory-token", [value]))

    for match in TAILSCALE_AUTHKEY_RE.finditer(line):
        value = match.group(1)
        specific_secret_values.append(value)
        hits.append(("tailscale-authkey", [value]))

    if ("=" in line or ":" in line) and len(INLINE_CODE_RE.findall(line)) < 2:
        for match in OP_URI_RE.finditer(line):
            value = match.group(1)
            specific_secret_values.append(value)
            hits.append(("op-uri", [value]))

    for match in BEARER_TOKEN_RE.finditer(line):
        value = match.group(1)
        if looks_real_value(value):
            specific_secret_values.append(value)
            hits.append(("bearer-token", [value]))

    # Keep in sync conceptually with family-hot-lint's smaller pattern list when audit F4 reconciles scanners.
    if specific_secret_values or has_sha256_context(lines, index) or has_commit_context(line):
        return hits

    reported_high_entropy_values = set()
    for match in HIGH_RISK_TOKEN_RE.finditer(line):
        value = match.group(1)
        if is_known_high_risk_token(value):
            reported_high_entropy_values.add(value)
            hits.append(("high-entropy", [value]))

    for match in HIGH_ENTROPY_TOKEN_RE.finditer(line):
        value = match.group(1)
        if value in reported_high_entropy_values or is_placeholder(value) or not has_high_entropy_context(line, value):
            continue
        entropy = shannon_entropy(value)
        if HEX_RE.fullmatch(value):
            if len(value) >= 64 and entropy > 3.5:
                hits.append(("high-entropy", [value]))
        elif entropy > 4.0:
            hits.append(("high-entropy", [value]))
    return hits


def line_findings(path, line_number, line, lines, index):
    return [
        finding(path, line_number, rule_id, line, secrets)
        for rule_id, secrets in line_hits(line, lines, index)
    ]


def redact_text(text):
    lines = text.splitlines(keepends=True)
    comparable_lines = [line.rstrip("\r\n") for line in lines]
    if text and not lines:
        comparable_lines = [text]
        lines = [text]
    redacted_lines = []
    redacted_count = 0
    for index, raw_line in enumerate(lines):
        line = comparable_lines[index]
        suffix = raw_line[len(line) :]
        redacted = line
        replacements = []
        for rule_id, secrets in line_hits(line, comparable_lines, index):
            for secret in secrets:
                if secret:
                    replacements.append((secret, f"<REDACTED:{rule_id}>"))
        for secret, placeholder in sorted(replacements, key=lambda item: len(item[0]), reverse=True):
            if secret in redacted:
                redacted = redacted.replace(secret, placeholder)
                redacted_count += 1
        redacted_lines.append(redacted + suffix)
    return "".join(redacted_lines), redacted_count


def scan_lines(path, lines, start_line=1):
    findings = []
    for index, line in enumerate(lines):
        findings.extend(line_findings(path, start_line + index, line, lines, index))
    return findings


def read_text_file(path):
    try:
        raw = path.read_bytes()
    except OSError as exc:
        raise SecretScanError(f"cannot read {path}: {exc}") from exc
    if b"\0" in raw:
        return None
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        return None


def iter_paths(paths):
    for root in paths:
        path = Path(root)
        if not path.exists():
            raise SecretScanError(f"path does not exist: {path}")
        if path.is_dir():
            for dirpath, dirnames, filenames in os.walk(path):
                dirnames[:] = [name for name in dirnames if name != ".git"]
                for filename in filenames:
                    yield Path(dirpath) / filename
        elif path.is_file():
            yield path
        else:
            raise SecretScanError(f"path is not a regular file or directory: {path}")


def scan_paths(paths):
    findings = []
    for path in iter_paths(paths):
        text = read_text_file(path)
        if text is None:
            continue
        findings.extend(scan_lines(str(path), text.splitlines(), 1))
    return findings


def diff_path(header_line):
    value = header_line[4:].strip()
    if value == "/dev/null":
        return None
    if value.startswith("b/"):
        return value[2:]
    return value


def staged_blob_lines(path):
    try:
        result = subprocess.run(
            ["git", "show", f":{path}"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except OSError:
        return None
    if result.returncode != 0 or b"\0" in result.stdout:
        return None
    try:
        return result.stdout.decode("utf-8").splitlines()
    except UnicodeDecodeError:
        return None


def scan_staged():
    try:
        result = subprocess.run(
            ["git", "diff", "--cached", "-U0", "--no-color", "--no-ext-diff"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except OSError as exc:
        raise SecretScanError(f"cannot run git diff: {exc}") from exc
    if result.returncode != 0:
        raise SecretScanError(f"git diff --cached failed: {result.stderr.strip()}")

    findings = []
    current_path = None
    current_line = None
    added_lines = []
    added_meta = []
    blob_cache = {}
    pending_old_header = False

    def flush_added():
        nonlocal added_lines, added_meta
        for index, line in enumerate(added_lines):
            path, line_number = added_meta[index]
            if path not in blob_cache:
                blob_cache[path] = staged_blob_lines(path)
            blob_lines = blob_cache[path]
            if blob_lines is not None and 1 <= line_number <= len(blob_lines):
                findings.extend(line_findings(path, line_number, line, blob_lines, line_number - 1))
            else:
                findings.extend(line_findings(path, line_number, line, added_lines, index))
        added_lines = []
        added_meta = []

    for raw_line in result.stdout.splitlines():
        if raw_line.startswith("diff --git "):
            flush_added()
            current_path = None
            current_line = None
            pending_old_header = False
            continue
        if raw_line.startswith("--- ") and current_line is None:
            pending_old_header = True
            continue
        if raw_line.startswith("+++ ") and pending_old_header:
            flush_added()
            current_path = diff_path(raw_line)
            current_line = None
            pending_old_header = False
            continue
        hunk_match = HUNK_RE.match(raw_line)
        if hunk_match:
            flush_added()
            current_line = int(hunk_match.group(1))
            pending_old_header = False
            continue
        if current_path is None or current_line is None:
            pending_old_header = False
            continue
        pending_old_header = False
        if raw_line.startswith("+"):
            added_lines.append(raw_line[1:])
            added_meta.append((current_path, current_line))
            current_line += 1
        elif raw_line.startswith("-"):
            continue
        elif raw_line.startswith("\\"):
            continue
        else:
            current_line += 1
    flush_added()
    return findings


def parse_args(argv):
    parser = argparse.ArgumentParser(description="Scan staged diffs or files for secret-like values.")
    parser.add_argument("--staged", action="store_true", help="scan staged git diff added lines only")
    parser.add_argument(
        "--redact",
        action="store_true",
        help="read UTF-8 text from stdin and write redacted text to stdout; exit 1 means redactions were made, exit 3 means stdout must not be used",
    )
    parser.add_argument("paths", nargs="*", help="files or directories to scan")
    args = parser.parse_args(argv)
    modes = int(args.staged) + int(args.redact)
    if modes > 1:
        parser.error("--staged and --redact cannot be combined")
    if (args.staged or args.redact) and args.paths:
        parser.error("--staged and --redact cannot be combined with paths")
    if not args.staged and not args.redact and not args.paths:
        parser.error("provide --staged, --redact, or at least one path")
    return args


def run_redact():
    raw = sys.stdin.buffer.read()
    if b"\0" in raw:
        raise SecretScanError("stdin is binary or contains NUL bytes")
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise SecretScanError(f"stdin is not valid UTF-8: {exc}") from exc
    redacted, count = redact_text(text)
    sys.stdout.write(redacted)
    return 1 if count else 0


def run(argv):
    args = parse_args(argv)
    if args.redact:
        return run_redact()
    findings = scan_staged() if args.staged else scan_paths(args.paths)
    for item in findings:
        print(item)
    return 2 if findings else 0


def main(argv=None):
    try:
        return run(sys.argv[1:] if argv is None else argv)
    except SystemExit as exc:
        if exc.code in (None, 0):
            return 0
        return 1
    except SecretScanError as exc:
        print(f"secret-scan: error: {exc}", file=sys.stderr)
        return 3 if "--redact" in (sys.argv[1:] if argv is None else argv) else 1
    except Exception as exc:
        print(f"secret-scan: error: {exc}", file=sys.stderr)
        return 3 if "--redact" in (sys.argv[1:] if argv is None else argv) else 1


if __name__ == "__main__":
    sys.exit(main())
