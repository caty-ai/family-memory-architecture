#!/usr/bin/env python3
"""Render a static health dashboard from the registered job heartbeats."""

import argparse
import html
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import datetime, timedelta, timezone
from pathlib import Path


DEFAULT_HEARTBEAT_DIR = "~/.claude/state/heartbeats"
DEFAULT_OUT = "~/.claude/state/dashboard/index.html"
STATE_ORDER = {"FAIL": 0, "STALE": 1, "NO_DATA": 2, "OK": 3}
STATE_META = {
    "FAIL": ("🔴", "FAIL"),
    "STALE": ("⚪️", "STALE"),
    "NO_DATA": ("◻️", "NO DATA"),
    "OK": ("🟢", "OK"),
}


def load_watchdog():
    script = Path(__file__).resolve().with_name("watchdog")
    loader = importlib.machinery.SourceFileLoader("backup_dashboard_watchdog", str(script))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


WATCHDOG = load_watchdog()


def expand_path(path_text):
    return Path(os.path.expandvars(os.path.expanduser(path_text)))


def default_manifest_path():
    return Path(__file__).resolve().parents[1] / "manifests" / "jobs.yaml"


def utc_z(value):
    return value.astimezone(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def relative_time(value, now):
    delta = now - value
    seconds = max(0, int(delta.total_seconds()))
    if seconds < 60:
        return "just now"
    if seconds < 3600:
        return f"{seconds // 60}m ago"
    if seconds < 86400:
        return f"{seconds // 3600}h ago"
    return f"{seconds // 86400}d ago"


def read_heartbeat(path):
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(payload, dict) or not WATCHDOG.REQUIRED_HEARTBEAT_KEYS.issubset(payload):
            raise ValueError("missing required heartbeat keys")
        last_run = WATCHDOG.parse_iso_utc(payload["last_run"])
        fail_count = int(payload["fail_count"])
        return payload, last_run, fail_count, None
    except (OSError, ValueError, TypeError, json.JSONDecodeError) as exc:
        return None, None, None, f"invalid heartbeat: {exc}"


def job_state(job, heartbeat_dir, now, aggregated_hosts):
    path = heartbeat_dir / job["heartbeat"]
    if not path.exists():
        return {"state": "NO_DATA" if job["host"] in aggregated_hosts else "NEUTRAL", "reason": "heartbeat missing", "last_run": None, "last_run_raw": None, "fail_count": None}
    payload, last_run, fail_count, error = read_heartbeat(path)
    if error:
        return {"state": "NO_DATA" if job["host"] in aggregated_hosts else "NEUTRAL", "reason": error, "last_run": None, "last_run_raw": None, "fail_count": None}
    if payload.get("status") == "fail":
        return {"state": "FAIL", "reason": str(payload.get("reason", "heartbeat status fail")), "last_run": last_run, "last_run_raw": payload["last_run"], "fail_count": fail_count}
    period_hours = job.get("period_hours")
    if isinstance(period_hours, (int, float)) and now - last_run > timedelta(hours=float(period_hours) * 2):
        return {"state": "STALE", "reason": "heartbeat stale", "last_run": last_run, "last_run_raw": payload["last_run"], "fail_count": fail_count}
    return {"state": "OK", "reason": str(payload.get("reason", "")), "last_run": last_run, "last_run_raw": payload["last_run"], "fail_count": fail_count}


def github_push_times(slugs, no_github):
    push_times = {}
    if no_github:
        return push_times
    for slug in sorted(slugs):
        try:
            result = subprocess.run(
                ["gh", "api", f"repos/{slug}", "--jq", ".pushed_at"], text=True,
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=10, check=False,
            )
            if result.returncode == 0:
                push_times[slug] = WATCHDOG.parse_iso_utc(result.stdout.strip())
        except (OSError, ValueError, subprocess.TimeoutExpired):
            pass
    return push_times


def escape(value):
    return html.escape(str(value), quote=True)


def valid_repo_slug(value):
    return isinstance(value, str) and bool(re.match(r"^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$", value))


def row_html(item, now, push_times):
    job = item["job"]
    state = item["state"]
    icon, label = STATE_META.get(state, ("○", "NOT YET AGGREGATED"))
    if item["last_run"] is None:
        last_run = "—"
    else:
        raw = item["last_run_raw"]
        last_run = f'<time title="{escape(raw)}">{escape(relative_time(item["last_run"], now))}</time>'
    repo = "—"
    slug = job.get("repo")
    if valid_repo_slug(slug):
        repo = f'<a href="https://github.com/{escape(slug)}">{escape(slug)}</a>'
        if slug in push_times:
            repo += f' <span class="push">({escape(relative_time(push_times[slug], now))})</span>'
    fail_count = "—" if item["fail_count"] is None else escape(item["fail_count"])
    return (
        f'<tr class="state-{escape(state.lower())}">'
        f'<td><span class="badge badge-{escape(state.lower())}">{icon} {escape(label)}</span></td>'
        f'<td>{escape(job["owner"])}</td><td title="{escape(job["desc"])}">{escape(job["id"])}</td>'
        f'<td>{escape(job["host"])}</td><td>{last_run}</td><td>{fail_count}</td>'
        f'<td>{escape(item["reason"] or "—")}</td><td>{repo}</td></tr>'
    )


def table_html(title, items, now, push_times):
    rows = "\n".join(row_html(item, now, push_times) for item in items)
    return f"""<section><h2>{escape(title)}</h2>
<div class=\"table-wrap\"><table><thead><tr><th>状態</th><th>agent</th><th>job</th><th>host</th><th>last run</th><th>fails</th><th>reason</th><th>repo</th></tr></thead>
<tbody>{rows}</tbody></table></div></section>"""


def render_html(items, now, push_times):
    main = sorted((item for item in items if item["state"] != "NEUTRAL"), key=lambda item: (STATE_ORDER[item["state"]], item["job"]["owner"], item["job"]["id"]))
    neutral = sorted((item for item in items if item["state"] == "NEUTRAL"), key=lambda item: (item["job"]["owner"], item["job"]["id"]))
    counts = {state: sum(item["state"] == state for item in main) for state in STATE_ORDER}
    generated_utc = utc_z(now)
    generated_jst = now.astimezone(timezone(timedelta(hours=9))).strftime("%Y-%m-%d %H:%M:%S JST")
    sections = [table_html("Job health", main, now, push_times)]
    if neutral:
        sections.append(table_html("Not yet aggregated (neutral)", neutral, now, push_times))
    return f"""<!doctype html>
<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><meta http-equiv=\"refresh\" content=\"300\"><title>Family Backup Dashboard</title>
<style>
:root {{ color-scheme: light dark; --bg:#f7f8fa; --fg:#1d2733; --card:#fff; --line:#d8dee5; --muted:#5f6b77; --fail:#a61b1b; --stale:#686868; --none:#735900; --ok:#16733b; }}
* {{ box-sizing:border-box; }} body {{ margin:0; padding:20px; background:var(--bg); color:var(--fg); font:15px/1.4 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }} main {{ max-width:1300px; margin:auto; }} h1 {{ margin:0; }} h2 {{ margin:28px 0 8px; font-size:1.2rem; }} .meta,.summary,footer {{ color:var(--muted); }} .summary {{ font-size:1.05rem; }} .table-wrap {{ overflow-x:auto; background:var(--card); border:1px solid var(--line); border-radius:8px; }} table {{ width:100%; border-collapse:collapse; min-width:850px; }} th,td {{ padding:9px 10px; text-align:left; vertical-align:top; border-bottom:1px solid var(--line); }} th {{ white-space:nowrap; background:color-mix(in srgb,var(--card) 85%,var(--bg)); }} tr:last-child td {{ border-bottom:0; }} .badge {{ display:inline-block; border-radius:999px; padding:2px 7px; font-size:.8rem; font-weight:700; white-space:nowrap; }} .badge-fail {{ color:var(--fail); background:#ffe5e5; }} .badge-stale {{ color:var(--stale); background:#ededed; }} .badge-no_data {{ color:var(--none); background:#fff5cc; }} .badge-ok {{ color:var(--ok); background:#e1f6e8; }} .badge-neutral {{ color:var(--muted); background:#eef1f4; }} .state-fail {{ background:#fff7f7; }} .state-stale {{ background:#fafafa; }} .state-no_data {{ background:#fffdf5; }} a {{ color:#0969da; }} .push {{ color:var(--muted); white-space:nowrap; }} footer {{ margin-top:28px; font-size:.85rem; }}
@media (prefers-color-scheme: dark) {{ :root {{ --bg:#12171d; --fg:#e4eaf0; --card:#1a222c; --line:#33404d; --muted:#a8b4c0; --fail:#ff9b9b; --stale:#d0d0d0; --none:#ffe08a; --ok:#8de0a9; }} .badge-fail {{ background:#4c2024; }} .badge-stale {{ background:#393939; }} .badge-no_data {{ background:#4a3d15; }} .badge-ok {{ background:#173f28; }} .badge-neutral {{ background:#2a323b; }} .state-fail {{ background:#2c191d; }} .state-stale {{ background:#24282c; }} .state-no_data {{ background:#2d2918; }} a {{ color:#7db7ff; }} }}
</style></head><body><main><header><h1>Family Backup Dashboard</h1><p class=\"meta\">Generated <time title=\"{escape(generated_utc)}\">{escape(generated_utc)}</time> / {escape(generated_jst)}</p><p class=\"summary\">Main table: 🔴{counts['FAIL']} / ⚪️{counts['STALE']} / ◻️{counts['NO_DATA']} / 🟢{counts['OK']}; neutral not-yet-aggregated: {len(neutral)}</p></header>
{''.join(sections)}<footer>backup-dashboard v1 (fma #69)</footer></main></body></html>
"""


def parse_args(argv):
    parser = argparse.ArgumentParser(description="Generate the family backup dashboard.")
    parser.add_argument("--jobs", default=str(default_manifest_path()))
    parser.add_argument("--heartbeat-dir")
    parser.add_argument("--out", default=DEFAULT_OUT)
    parser.add_argument("--aggregated-hosts", default="laptop,desktop")
    parser.add_argument("--no-github", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    return parser.parse_args(argv)


def run(args):
    manifest = WATCHDOG.parse_manifest(expand_path(args.jobs))
    jobs = manifest.get("jobs", [])
    heartbeat_dir = expand_path(args.heartbeat_dir or os.environ.get("FMA_HEARTBEAT_DIR") or DEFAULT_HEARTBEAT_DIR)
    now = datetime.now(timezone.utc)
    aggregated_hosts = {host.strip() for host in args.aggregated_hosts.split(",") if host.strip()}
    items = [{"job": job, **job_state(job, heartbeat_dir, now, aggregated_hosts)} for job in jobs]
    slugs = {job["repo"] for job in jobs if valid_repo_slug(job.get("repo"))}
    rendered = render_html(items, now, github_push_times(slugs, args.no_github))
    if args.dry_run:
        print(rendered)
        return
    out = expand_path(args.out)
    os.makedirs(out.parent, exist_ok=True)
    temp_name = None
    try:
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=out.parent, delete=False) as tmp:
            temp_name = tmp.name
            tmp.write(rendered)
        os.replace(temp_name, out)
    except Exception:
        if temp_name is not None:
            try:
                os.unlink(temp_name)
            except OSError:
                pass
        raise


def main(argv=None):
    try:
        run(parse_args(argv))
    except (WATCHDOG.ManifestError, OSError, ValueError) as exc:
        print(f"backup-dashboard: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
