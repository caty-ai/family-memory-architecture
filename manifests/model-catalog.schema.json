{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/caty-ai/family-memory-architecture/manifests/model-catalog.schema.json",
  "title": "Family model catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "date",
    "revision_effective_after",
    "changelog",
    "blast_radius",
    "models"
  ],
  "properties": {
    "revision": {"type": "integer", "minimum": 1},
    "date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "revision_effective_after": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "changelog": {"type": "string", "minLength": 1},
    "blast_radius": {"type": "string", "minLength": 1},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/model"}
    }
  },
  "definitions": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lineage",
        "tier",
        "rank",
        "status",
        "quorum_eligible",
        "cost_class",
        "escalation_only",
        "data_handling",
        "date"
      ],
      "properties": {
        "id": {"$ref": "#/definitions/nonEmptyString"},
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "vendor"],
          "properties": {
            "family": {"$ref": "#/definitions/nonEmptyString"},
            "vendor": {"$ref": "#/definitions/nonEmptyString"}
          }
        },
        "tier": {"enum": ["priority", "substitute"]},
        "rank": {"type": "integer", "minimum": 1},
        "status": {"enum": ["current", "trial", "retired"]},
        "quorum_eligible": {"type": "boolean"},
        "recheck_after": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "cost_class": {"enum": ["subscription", "cheap-api", "expensive"]},
        "escalation_only": {"type": "boolean"},
        "data_handling": {"enum": ["standard", "training-contributor"]},
        "date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "trial"}}, "required": ["status"]},
          "then": {
            "required": ["recheck_after"],
            "properties": {"quorum_eligible": {"const": false}}
          }
        },
        {
          "if": {"properties": {"status": {"const": "retired"}}, "required": ["status"]},
          "then": {
            "properties": {"quorum_eligible": {"const": false}}
          }
        }
      ]
    }
  }
}
