{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/caty-ai/family-memory-architecture/manifests/member-state/schema.json",
  "title": "Model catalog member adoption state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "member",
    "catalog_digest_adopted",
    "config_digest",
    "referenced_ids",
    "verified_at",
    "spec_version",
    "vectors_version"
  ],
  "properties": {
    "member": {"type": "string", "minLength": 1},
    "catalog_digest_adopted": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "referenced_ids": {
      "$comment": "Sortedness (bytewise/codepoint ascending, LC_ALL=C) and rejection of whitespace-only strings are enforced only by scripts/model-catalog-check; they cannot be expressed in JSON Schema, so a stock validator provides the loose view.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "verified_at": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "spec_version": {"type": "string", "minLength": 1},
    "vectors_version": {"type": "string", "minLength": 1}
  }
}
